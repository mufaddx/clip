# ─────────────────────────────────────────────────────────────
# CLIP platform — environment variables
# Copy to .env (root) and to each app's .env.local as needed.
# Never commit the real .env file. Never hardcode these values
# in application code — always read from process.env.
# ─────────────────────────────────────────────────────────────

# --- Domains -----------------------------------------------------
# Swap this single value to move the whole platform to a real domain.
PRIMARY_DOMAIN=domain.in
NODE_ENV=development

# Full origins for each app (scheme + host, no trailing slash).
# Local dev uses distinct ports on localhost since real subdomains
# require /etc/hosts entries or a local DNS wildcard — see
# docs/deployment/DOMAIN_DEPLOYMENT.md for the local-subdomain setup.
PUBLIC_APP_URL=http://localhost:3000
CLIPPER_APP_URL=http://localhost:3001
BRAND_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003
API_URL=http://localhost:4000

# --- Auth ----------------------------------------------------------
AUTH_SECRET=replace-with-32-byte-random-secret
AUTH_COOKIE_DOMAIN=.localhost
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

# --- Database --------------------------------------------------------
DATABASE_URL=postgresql://clip:clip@localhost:5432/clip_dev

# --- Redis / background jobs -----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Meta / Instagram integration -------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/v1/instagram/oauth/callback
META_GRAPH_API_VERSION=v21.0

# --- Payments ----------------------------------------------------------
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------
EMAIL_FROM=no-reply@domain.in
EMAIL_PROVIDER_API_KEY=
