# ─────────────────────────────────────────────────────────────
# CLIP platform — environment variables
# Copy to .env (root) and to each app's .env.local as needed.
# Never commit the real .env file. Never hardcode these values
# in application code — always read from process.env.
# ─────────────────────────────────────────────────────────────

# --- Domains -----------------------------------------------------
# Swap this single value to move the whole platform to a real domain.
# CLIP's real production domain is vidlix.in (see the production block below) —
# the docs under /docs still use the illustrative placeholder "domain.in" when
# explaining the architecture, since the whole point of PRIMARY_DOMAIN is that
# swapping the real domain in is an env-only change, never a doc/code edit.
PRIMARY_DOMAIN=domain.in
NODE_ENV=development

# Full origins for each app (scheme + host, no trailing slash).
# Local dev uses distinct ports on localhost since real subdomains
# require /etc/hosts entries or a local DNS wildcard — see
# docs/deployment/DOMAIN_DEPLOYMENT.md for the local-subdomain setup.
PUBLIC_APP_URL=http://localhost:3000
CLIPPER_APP_URL=http://localhost:3001
BRAND_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003
API_URL=http://localhost:4000

# Next.js only exposes env vars prefixed NEXT_PUBLIC_ to the browser bundle —
# these mirror the values above for client-side redirects (see
# docs/architecture/SECURITY_ARCHITECTURE.md "Secrets"). Never put a secret
# behind a NEXT_PUBLIC_ name.
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLIPPER_APP_URL=http://localhost:3001
NEXT_PUBLIC_BRAND_APP_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Production reference (vidlix.in) ---------------------------------
# Not active locally — this block documents the values Staging/Production
# actually use (set directly in the hosting provider's env config per
# docs/deployment/ENVIRONMENT_STRATEGY.md, never committed as a real .env).
# PRIMARY_DOMAIN=vidlix.in
# PUBLIC_APP_URL=https://vidlix.in
# CLIPPER_APP_URL=https://clipper.vidlix.in
# BRAND_APP_URL=https://brand.vidlix.in
# ADMIN_APP_URL=https://admin.vidlix.in
# API_URL=https://api.vidlix.in
# NEXT_PUBLIC_PUBLIC_APP_URL=https://vidlix.in
# NEXT_PUBLIC_CLIPPER_APP_URL=https://clipper.vidlix.in
# NEXT_PUBLIC_BRAND_APP_URL=https://brand.vidlix.in
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.vidlix.in
# NEXT_PUBLIC_API_URL=https://api.vidlix.in
# AUTH_COOKIE_DOMAIN=.vidlix.in
# EMAIL_FROM=no-reply@vidlix.in

# --- Auth ----------------------------------------------------------
AUTH_SECRET=replace-with-32-byte-random-secret
AUTH_COOKIE_DOMAIN=.localhost
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

# --- Database --------------------------------------------------------
DATABASE_URL=postgresql://clip:clip@localhost:5432/clip_dev

# --- Redis / background jobs -----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Meta / Instagram integration -------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/v1/instagram/oauth/callback
META_GRAPH_API_VERSION=v21.0

# --- Payments ----------------------------------------------------------
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------
EMAIL_FROM=no-reply@domain.in
EMAIL_PROVIDER_API_KEY=
